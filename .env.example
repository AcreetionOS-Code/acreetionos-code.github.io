# Example .env (do NOT store secrets here)
# Copy this file to .env locally and populate the values from your secret store.

# Store the OpenRouter API key as a Cloudflare Worker secret: wrangler secret put OPENROUTER_API_KEY
OPENROUTER_API_KEY=

# AI testing key used only in CI (set in GitHub Actions secrets)
AI_TEST_API_KEY=

# Cloudflare deployment token (use wrangler and set as secret in CI / local env)
CLOUDFLARE_API_TOKEN=

# Origin CA Key (if applicable) - do not commit the actual key
CLOUDFLARE_ORIGIN_CA_KEY=

# Newsletter delivery via Gmail SMTP (App Password)
# Gmail address to send FROM (e.g. developers@acreetionos.org)
# This must be a Gmail address with an App Password enabled
# https://support.google.com/accounts/answer/185833
EMAIL_ADDRESS=developers@acreetionos.org

# Gmail App Password for the above account
# Generate at: https://myaccount.google.com/apppasswords
EMAIL_APP_PASSWORD=

# Admin key for Worker API access (fetching subscriber list)
ADMIN_KEY=

# reCAPTCHA Enterprise (project clean-502708) — protects newsletter/hosting/chat forms
# RECAPTCHA_API_KEY        — the SITE key (6Lf…, public by design). Served to the
#   browser from GET /api/config/public, so it is NOT hardcoded in the source;
#   rotating it is a secret change, not a code change.
# RECAPTCHA_API_SECRET_KEY — the server-side secret
#   AIza…  Google Cloud API key → Enterprise assessments API (matches the
#          Enterprise tokens recaptcha.js emits — use this)
#   6L…    classic v2/v3 secret → siteverify (cannot validate an Enterprise token)
#   Both keys must belong to project clean-502708. Create at
#   https://console.cloud.google.com/recaptcha/enterprise?project=clean-502708
#   (enable the reCAPTCHA Enterprise API first). Set with:
#     npx wrangler secret put RECAPTCHA_API_KEY
#     npx wrangler secret put RECAPTCHA_API_SECRET_KEY
RECAPTCHA_API_KEY=
RECAPTCHA_API_SECRET_KEY=
